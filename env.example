# Node.js 22+ | bu dosyayı .env adıyla kopyalayın. Gerçek anahtarları Git'e koymayın.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_SITE=global
# Gerçek hesap varsayılanı. Gerçek OKX API anahtarı kullanın.
OKX_DEMO=false
DASHBOARD_PASSWORD=
# Yerel kullanımda ./data-live; Railway kalıcı Volume için gerçek mount yolunu kullanın.
# Demo / canlı / farklı hesaplar için farklı klasör kullanın.
DATA_DIR=./data-live
PORT=3000
HOST=0.0.0.0
MAX_TRADE_USDT=100
MAX_ACTIVE_BOTS=5
POLL_MS=3000
# Yalnızca Telegram BotFather token; kişisel Telegram api_id/api_hash gerekli değil.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_COOLDOWN_MINUTES=60
# HTTPS ile yayınlarken production yapın. Yerel http için development.
NODE_ENV=development
TRUST_PROXY=false
